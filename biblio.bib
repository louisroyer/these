@INBOOK{10.1007/978-3-031-82830-0_8,
    author={Morais, Douglas H.},
    title={5G/5G-Advanced Overview},
    booktitle={5G/5G-Advanced, Wi-Fi 6/7, and Bluetooth 5/6: A Primer on Smartphone Wireless Technologies},
    year={2025},
    publisher={Springer Nature Switzerland},
    address={Cham},
    pages={103-148},
    keywords={5G-Advanced;RAN},
    abstract={In this chapter, key elements of 5G/5G-Advanced are reviewed with particular emphasis on enhanced mobile broadband (eMBB) as this is the feature that most impacts smartphone communication. First, the main architecture options for connection to the core network are reviewed followed by the Radio Access Network (RAN) protocol architecture. The RAN is responsible for all radio-related functions such as coding, modulation, HARQ operation, physical transmission, and scheduling. Following this, study within the RAN is narrowed to the physical layer as specified in 3GPP Release 15, the first 5G release, with emphasis on how the user data physical channels are structured. How maximum user data rates and low latency are achieved is demonstrated, 5G operating frequency spectrum reviewed, and some typical base station and UE parameters presented. Next, we address certain key features introduced in Release 16, Release 17, and Release 18 (5G-Advanced).},
    isbn={978-3-031-82830-0},
    doi={10.1007/978-3-031-82830-0_8},
}

@INBOOK{10.1002/9781119629658.ch1,
    author = {Launay, Frédéric and Perez, André},
    publisher = {John Wiley \& Sons, Ltd},
    title = {MBB Service – Network Architecture},
    booktitle = {LTE Advanced Pro},
    chapter = {1},
    pages = {1-27},
    year = {2019},
    keywords = {evolved packet system mobile network;evolved universal terrestrial radio access network;gateway entity;network architecture;packet data network;user plane separation architecture},
    abstract = {The Evolved Packet System mobile network consists of an Evolved Packet Core (EPC) network and an evolved universal terrestrial radio access network (E-UTRAN). The E-UTRAN ensures the connection of the user equipment, the resource allocation for the radio interface and the resource reservation when the mobile is switched from one cell to another. The EPC interconnects the access networks, provides the interface to the packet data network and controls the attachment of mobiles, the authorization to access the service and the establishment of bearers. The Control and User Plane Separation architecture consists of separating the functions of the control plane (CP) and user plane (UP) from the Serving Gateway and packet data network Gateway entities. This separation allows the flexibility of deployment of the EPC, the equipment that can be distributed or centralized, and an independent scaling between the functions of the CP and the UP.},
    isbn = {978-1-11962-965-8},
    doi = {10.1002/9781119629658.ch1},
}

@INPROCEEDINGS{10.1007/978-3-030-49190-1_2,
    author={Tomaszewski, Lechosław and Kukliński, Sławomir and Kołakowski, Robert},
    editor={Maglogiannis, Ilias and Iliadis, Lazaros and Pimenidis, Elias},
    title={A New Approach to 5G and MEC Integration},
    booktitle={Artificial Intelligence Applications and Innovations. AIAI 2020 IFIP WG 12.5 International Workshops},
    year={2020},
    publisher={Springer International Publishing},
    address={Cham},
    pages={15-24},
    keywords={5G; MEC; Networkslicing; Orchestration; Management; Architecture; Scalability},
    abstract="This paper presents a concept of integration of MEC into the 5G network slicing architecture. Three variants of the architecture have been proposed, which incorporate: individual MEP/MEPM for each slice, shared ones for multiple network slices and Distributed Autonomous Slice Management and Orchestration (DASMO) approach. Each variant is focused on efficient integration of 5G Core and MEC solutions and utilizing additional functionalities of both components, including MEC APIs and 5G Control Plane exposure capabilities. Finally, main issues of 5G-MEC implementation have been discussed, which include the aspects of MEC service APIs, MEC Apps mobility in demanding use cases, challenges of service continuity in roaming scenarios as well as the role and availability of 5G enablers.",
    issn={1868-422X},
    isbn={978-3-030-49190-1},
    doi={10.1007/978-3-030-49190-1_2},
